using LocalP2PGaming.Models;
using System;
using System.IO;
using System.Net;
using System.Net.Sockets;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;


public class NetworkManager
{
    private TcpListener? _tcpListener;
    public int Port { get; private set; } = 0;
    private TcpClient? _tcpClient;
    private StreamWriter? _writer;
    private StreamReader? _reader;
    private CancellationTokenSource _cts = new();

    public event Action<NetworkMessage>? OnMessageReceived;
    public event Action? OnDisconnected;

    public void StartHost()
    {
        try
        {
            // Request a dynamic port (0) and let the OS pick an available port
            _tcpListener = new TcpListener(IPAddress.Any, 0);
            _tcpListener.Start();
            // Read the actual bound port immediately so callers can advertise it
            if (_tcpListener.LocalEndpoint is IPEndPoint ep)
            {
                Port = ep.Port;
            }
            Console.WriteLine($"TCP Listener started on port {Port}");

            // Start accept loop in background
            Task.Run(async () =>
            {
                try
                {
                    while (!_cts.Token.IsCancellationRequested)
                    {
                        _tcpClient = await _tcpListener.AcceptTcpClientAsync(_cts.Token);
                        Console.WriteLine("TCP Client connected");
                        SetupStreams();
                    }
                }
                catch (OperationCanceledException) { /* Shutdown */ }
                catch (Exception ex) { Console.WriteLine($"TCP Accept Error: {ex.Message}"); }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"TCP StartHost Error: {ex.Message}");
        }
    }

    public async Task<bool> ConnectToPeerAsync(string ipAddress)
    {
        try
        {
            // Allow ipAddress to be provided as "host:port". If port omitted, fall back to default Port if set, otherwise 8889.
            string host = ipAddress;
            int port = Port != 0 ? Port : 8889;
            if (ipAddress.Contains(':'))
            {
                var parts = ipAddress.Split(':');
                host = parts[0];
                if (parts.Length > 1 && int.TryParse(parts[1], out var p)) port = p;
            }

            _tcpClient = new TcpClient();
            var timeoutTask = Task.Delay(5000); // 5 second timeout
            var connectTask = _tcpClient.ConnectAsync(host, port);

            if (await Task.WhenAny(connectTask, timeoutTask) == timeoutTask)
            {
                Console.WriteLine($"Connection to {host}:{port} timed out");
                _tcpClient.Close();
                return false;
            }

            System.Diagnostics.Debug.WriteLine($"Invite/Connect sent to {host}:{port}");
            Console.WriteLine($"Connected to peer at {host}:{port}");
            SetupStreams();
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ConnectToPeerAsync Error to {ipAddress}: {ex.Message}");
            return false;
        }
    }

    private void SetupStreams()
    {
        try
        {
            var stream = _tcpClient!.GetStream();
            _writer = new StreamWriter(stream) { AutoFlush = true };
            _reader = new StreamReader(stream);

            // Start background read loop
            Task.Run(ReceiveLoopAsync);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SetupStreams Error: {ex.Message}");
        }
    }

    private async Task ReceiveLoopAsync()
    {
        try
        {
            while (_tcpClient != null && _tcpClient.Connected && !_cts.IsCancellationRequested)
            {
                string? json = await _reader!.ReadLineAsync();
                if (string.IsNullOrEmpty(json))
                {
                    Console.WriteLine("Peer disconnected (empty read)");
                    break;
                }

                var message = JsonSerializer.Deserialize<NetworkMessage>(json);
                if (message != null)
                {
                    Console.WriteLine($"Message received: {message.Type} from {message.SenderName}");
                    OnMessageReceived?.Invoke(message);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ReceiveLoopAsync Error: {ex.Message}");
        }
        finally
        {
            Disconnect();
            OnDisconnected?.Invoke();
        }
    }

    public async Task SendMessageAsync(NetworkMessage message)
    {
        try
        {
            if (_writer == null)
            {
                Console.WriteLine("SendMessageAsync: Writer is null");
                return;
            }
            string json = JsonSerializer.Serialize(message);
            await _writer.WriteLineAsync(json);
            Console.WriteLine($"Message sent: {message.Type}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SendMessageAsync Error: {ex.Message}");
        }
    }

    public void Disconnect()
    {
        try
        {
            _cts.Cancel();
            _tcpListener?.Stop();
            _writer?.Dispose();
            _reader?.Dispose();
            _tcpClient?.Close();
            Console.WriteLine("Disconnected");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Disconnect Error: {ex.Message}");
        }
    }
}
